{
  "name": "@beesolve/lint-config",
  "version": "0.2.2",
  "description": "Shared Oxlint + Oxfmt configuration and custom rules for beesolve projects",
  "homepage": "https://github.com/beesolve/packages/tree/main/packages/lint-config#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beesolve/packages.git"
  },
  "bin": {
    "beesolve-lint-setup": "./scripts/setup.ts"
  },
  "files": [
    "oxfmt.json",
    "presets",
    "plugins",
    "scripts"
  ],
  "type": "module",
  "exports": {
    "./oxfmt.json": "./oxfmt.json",
    "./presets/*": "./presets/*",
    "./plugins/*": "./plugins/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "oxlint-plugin-eslint": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "oxfmt": ">=0.1.0",
    "oxlint": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    }
  }
}
