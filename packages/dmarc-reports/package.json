{
  "name": "@beesolve/dmarc-reports",
  "version": "0.0.2",
  "description": "DMARC report ingestion pipeline — SES to S3 to EventBridge via Lambda",
  "homepage": "https://github.com/beesolve/packages/tree/main/packages/dmarc-reports#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beesolve/packages.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/cdk.d.ts",
        "default": "./dist/cdk.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "bun build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@beesolve/cdk-constructs": "workspace:^",
