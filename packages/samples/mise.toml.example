[env]
AWS_ACCOUNT = "<your-aws-account-id>"
AWS_REGION = "eu-central-1"
SAMPLES_EMAIL_ADDRESS = "<ses-verified-email>"
SAMPLES_AUTH_EMAIL_SIMPLE_FRONTEND_URI = "<cloudfront-distribution-url>"
SAMPLES_AUTH_EMAIL_AUTHORIZER_FRONTEND_URI = "<cloudfront-distribution-url>"
SAMPLES_AUTH_WITH_EMAIL_FRONTEND_URI = "<cloudfront-distribution-url>"
SAMPLES_EMAIL_VERIFY_RECIPIENT_EMAIL = "<recipient-email>"
SAMPLES_EMAIL_VERIFY_FRONTEND_URI = "<cloudfront-distribution-url>"
