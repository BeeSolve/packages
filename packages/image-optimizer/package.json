{
  "name": "@beesolve/image-optimizer",
  "version": "0.0.0",
  "description": "Resize and re-encode S3 images behind CloudFront with imgix-style URL parameters, on a Bun Lambda",
  "keywords": [
    "aws",
    "bun",
    "cdk",
    "cloudfront",
    "image",
    "lambda",
    "resize",
    "s3",
    "webp"
  ],
  "homepage": "https://github.com/BeeSolve/packages/tree/main/packages/image-optimizer#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeeSolve/packages.git"
  },
  "files": [
    "dist",
    "docs/how-to",
    "DOCS.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/cdk.d.ts",
        "default": "./dist/cdk.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun build.ts",
    "build": "bun build.ts"
  },
  "dependencies": {
    "@beesolve/lambda-bun-runtime": "catalog:",
    "@beesolve/lambda-keep-active": "workspace:^"
  },
  "devDependencies": {
    "@beesolve/lambda-fetch-api": "workspace:^",
    "@types/aws-lambda": "catalog:",
    "@types/bun": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "esbuild": "catalog:",
    "valibot": "catalog:"
  },
  "peerDependencies": {
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
