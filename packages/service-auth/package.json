{
  "name": "@beesolve/auth-service",
  "version": "0.2.0",
  "description": "Email-code auth system backed by DynamoDB and EventBridge, deployable via CDK",
  "homepage": "https://github.com/beesolve/packages/tree/main/packages/service-auth#readme",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beesolve/packages.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/cdk.d.ts",
        "default": "./dist/cdk.js"
      }
    },
    "./sdk": {
      "import": {
        "types": "./dist/sdk.d.ts",
        "default": "./dist/sdk.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events.d.ts",
        "default": "./dist/events.js"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.lambda.json",
    "test": "bun test",
    "prepublishOnly": "bun run --bun build.ts"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/client-eventbridge": "catalog:",
    "@aws-sdk/client-lambda": "catalog:",
    "@aws-sdk/credential-providers": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@beesolve/action-tokens": "workspace:^",
    "@beesolve/cdk-constructs": "workspace:^",
    "@beesolve/cdk-email-alarms": "workspace:^",
    "@beesolve/helpers": "workspace:^",
    "@beesolve/lambda-fetch-api": "workspace:^",
    "@beesolve/lambda-keep-active": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:"
  }
}
