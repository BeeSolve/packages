{
  "name": "@beesolve/dmarc-dashboard",
  "version": "0.0.5",
  "description": "DMARC dashboard — SvelteKit app for viewing DMARC reports",
  "homepage": "https://github.com/beesolve/packages/tree/main/packages/dmarc-dashboard#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beesolve/packages.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./cdk": {
      "import": {
        "types": "./dist/cdk.d.ts",
        "default": "./dist/cdk.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "svelte-kit sync || true",
    "dev": "vite dev",
    "build": "DMARC_TABLE_NAME=build-placeholder DMARC_REVERSE_INDEX=build-placeholder vite build",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "prepublishOnly": "bun build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@beesolve/auth-service": "workspace:^",
    "@beesolve/cdk-constructs": "workspace:^",
    "@beesolve/dmarc-consumer": "workspace:^",
    "@beesolve/email-service": "workspace:^",
    "@beesolve/lambda-fetch-api": "workspace:^",
    "@drop-in/graffiti": "^4.30.0",
    "kit-on-lambda": "^0.6.1",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/aws-lambda": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "svelte": "^5.56.9",
    "svelte-check": "^4.2.1",
    "typescript": "^6.0.0",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:"
  },
  "peerDependenciesMeta": {
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  }
}
