# Local development env for `bun run dev`.
#
# Copy to `.env.local` (gitignored) and fill in real values from the deployed
# stack. Bun auto-loads `.env.local` into process.env before the dev server
# starts, so these reach both hooks.server.ts and the workspace SDK clients
# (which parse process.env at import time).
#
# You also need AWS credentials for the target account in your shell
# (e.g. `aws sso login` / an AWS_PROFILE) plus AWS_REGION, so the SDK clients
# can reach the real DynamoDB table, SQS queues, S3 buckets and Lambda.

# --- Fake session (DEV only) ---
# Set to a REAL user's email that exists in the dashboard table. In dev the auth
# service injects a valid session for this user (no sign-in needed), and the
# app looks it up to resolve role (admin/user).
# Only applied when import.meta.env.DEV is true; never bundled into the Lambda.
DEV_USER_EMAIL=you@example.com

# --- Email service dashboard (hooks.server.ts) ---
DASHBOARD_TABLE_NAME=
DASHBOARD_REVERSE_INDEX=

# --- Auth SDK (@beesolve/auth-service/sdk) ---
BEESOLVE_AUTH_SDK_HANDLER_ARN=

# --- Email SDK (@beesolve/email-service/sdk) ---
BEESOLVE_EMAILS_QUEUE_URL=
BEESOLVE_EMAILS_TABLE_NAME=
BEESOLVE_EMAILS_ATTACHMENTS_BUCKET=

# --- Optional ---
# AWS_REGION=eu-central-1
# AWS_PROFILE=your-sso-profile
