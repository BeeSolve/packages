{
  "name": "@beesolve/analytics-processor",
  "version": "0.8.0",
  "description": "CloudFront analytics processor — Athena-to-DynamoDB hourly totals, breakdowns, and rollups",
  "homepage": "https://github.com/BeeSolve/packages/tree/main/packages/analytics-processor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeeSolve/packages.git"
  },
  "bin": {
    "analytics-backfill": "./dist/command/backfill/backfill.mjs",
    "analytics-compact": "./dist/command/compact/compact.mjs",
    "analytics-watch-backfill": "./dist/command/watch-backfill/watch-backfill.mjs"
  },
  "files": [
    "dist",
    "DOCS.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/cdk.d.ts",
        "default": "./dist/cdk.js"
      }
    },
    "./sdk": {
      "import": {
        "types": "./dist/sdk.d.ts",
        "default": "./dist/sdk.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "backfill": "bun run command/backfill.ts",
    "watch-backfill": "bun run command/watch-backfill.ts",
    "compact": "bun run command/compact.ts",
    "prepublishOnly": "bun build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "catalog:",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/client-lambda": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@beesolve/cdk-constructs": "workspace:^",
    "@beesolve/dynamo-helpers": "workspace:^",
    "@beesolve/helpers": "workspace:^",
    "@beesolve/ip-info": "workspace:^",
    "@beesolve/lambda-keep-active": "workspace:^",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "esbuild": "catalog:"
  },
  "peerDependencies": {
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
