{
  "name": "@beesolve/packages-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "aws-cdk": "^2.1133.0",
      "aws-cdk-lib": "^2.262.0",
      "constructs": "^10.7.1",
      "valibot": "^1.4.2",
      "@aws-sdk/client-sqs": "^3.1094.0",
      "@types/aws-lambda": "^8.10.162",
      "@aws-sdk/client-lambda": "^3.1094.0",
      "@aws-sdk/credential-providers": "^3.1094.0",
      "@aws-sdk/client-resource-groups-tagging-api": "^3.1051.0",
      "@beesolve/lambda-keep-active": "^2.0.0",
      "mimetext": "^3.0.27",
      "@aws-sdk/lib-dynamodb": "^3.1094.0",
      "@aws-sdk/client-eventbridge": "^3.1094.0",
      "@aws-sdk/client-s3": "^3.1094.0",
      "@aws-sdk/client-sesv2": "^3.1094.0",
      "@aws-sdk/client-dynamodb": "^3.1094.0",
      "@react-email/components": "1.0.12",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@types/react": "^19.2.17",
      "typescript": "^7.0.2",
      "@types/node": "^26.1.1",
      "@types/bun": "1.3.14",
      "esbuild": "^0.28.1",
      "@standard-schema/spec": "^1.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint packages/ scripts/",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint packages/ scripts/",
    "build": "bunup && bun scripts/buildLambdas.ts",
    "dev": "bunup --watch",
    "test": "bun run --filter '*' test",
    "type-check": "bun run --filter '*' type-check",
    "version": "changeset version",
    "publish:packages": "bun run build && bun scripts/publish.ts",
    "add-package": "bun scripts/add-package.ts",
    "recalculate-dependencies": "bun scripts/recalculate-dependencies.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-plugin-eslint": "^1.75.0",
    "typescript": "^7.0.2"
  }
}
