{
  "name": "@beesolve/packages-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "aws-cdk": "^2.1145.0",
      "aws-cdk-lib": "^2.273.0",
      "constructs": "^10.8.1",
      "valibot": "^1.5.0",
      "@aws-sdk/client-athena": "^3.1150.0",
      "@aws-sdk/client-cloudformation": "^3.1150.0",
      "@aws-sdk/client-secrets-manager": "^3.1150.0",
      "@aws-sdk/client-sts": "^3.1150.0",
      "@aws-sdk/client-sqs": "^3.1150.0",
      "@types/aws-lambda": "^8.10.164",
      "@aws-sdk/client-lambda": "^3.1150.0",
      "@aws-sdk/credential-providers": "^3.1150.0",
      "@aws-sdk/client-resource-groups-tagging-api": "^3.1051.0",
      "mimetext": "^3.0.28",
      "@aws-sdk/lib-dynamodb": "^3.1150.0",
      "@aws-sdk/client-eventbridge": "^3.1150.0",
      "@aws-sdk/client-s3": "^3.1150.0",
      "@aws-sdk/client-sesv2": "^3.1150.0",
      "@aws-sdk/client-dynamodb": "^3.1150.0",
      "@react-email/components": "1.0.12",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "@types/react": "^19.3.0",
      "typescript": "^7.0.2",
      "@types/node": "^26.6.5",
      "@types/bun": "1.4.4",
      "esbuild": "^0.28.2",
      "@standard-schema/spec": "^1.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint packages/ scripts/ --ignore-pattern packages/samples/",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "check": "bun fmt --no-script --check && oxlint packages/ scripts/ --ignore-pattern packages/samples/",
    "build": "bun scripts/cleanDist.ts && bunup && bun scripts/buildLambdas.ts",
    "dev": "bunup --watch",
    "test": "bun run build && bun run --filter '*' test",
    "type-check": "bun run --filter '*' type-check",
    "version": "changeset version",
    "publish:packages": "bun run build && bun scripts/publish.ts",
    "add-package": "bun scripts/add-package.ts",
    "recalculate-dependencies": "bun scripts/recalculate-dependencies.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxlint": "^1.87.0",
    "oxlint-plugin-eslint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@smithy/types": "^4.17.0"
  }
}
